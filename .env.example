# Server-only settings. Copy to .env.local and supply deployment values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Comma-separated exact Google account addresses. Access is denied if empty.
ALLOWED_EMAILS=you@example.com
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ANALYTICS_API_URL=https://nodeapp-v4-647674633762.europe-west1.run.app
# Optional bearer credential for the upstream analytics service.
ANALYTICS_API_TOKEN=
